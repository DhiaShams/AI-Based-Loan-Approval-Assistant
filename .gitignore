# Data folders - keep folder structure but ignore large local CSVs
data/raw/*.csv
data/interim/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Model artifacts
models/*.joblib
models/*.pkl

# Reports
reports/figures/*.png
reports/metrics/*.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment / notebooks
.env
.ipynb_checkpoints/